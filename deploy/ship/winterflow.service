# WinterFlow standalone (API + web UI + agent + orchestrator), installed by
# ship: `ship install winterflow`. A unit TEMPLATE: ship fills in its
# placeholders at install time, creates the user, /opt, /etc, /var/lib and
# /run directories itself, and seeds {{ENV_FILE}} from winterflow.env.example.
# Same unit as scripts/install.sh writes, minus its per-host CPUQuota= and
# MemoryMax= (add them with `systemctl edit {{UNIT}}` if you want them).
[Unit]
Description=WinterFlow standalone (API + agent + orchestrator)
Documentation=https://github.com/dmtrkzntsv/winterflow
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User={{USER}}
Group={{USER}}
# Deploying apps drives `docker compose` through the Docker socket. Note:
# docker group membership is effectively root on this host.
SupplementaryGroups=docker
EnvironmentFile={{ENV_FILE}}
# Relative paths in the env file (the database, AGENT_DATA_DIR, HUB_CERT_DIR)
# resolve against {{DATA_DIR}}, here and under `ship run winterflow -- ...`.
WorkingDirectory={{DATA_DIR}}
ExecStart={{BIN}} serve
Restart=on-failure
RestartSec=5

# Logging: one journald namespace per service (`ship logs` reads it), plus a
# rate limit so a runaway log loop cannot flood the journal.
LogNamespace={{SERVICE}}
LogRateLimitIntervalSec=30s
LogRateLimitBurst=10000

# Resource limits. App containers run under dockerd and are NOT limited here.
CPUWeight=90
TasksMax=512
LimitNOFILE=65536

# Allow binding the ingress ports 80/443 without root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Hardening. The Docker socket stays writable: app deployment shells out to
# 'docker compose'. /mnt and /media (the usual mount points of USB disks and
# NFS/CIFS shares) stay writable for local backup storages; any other folder
# needs a drop-in, see docs/recipes/backup-storage.md.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths={{DATA_DIR}}
ReadWritePaths=-/run/docker.sock
ReadWritePaths=-/var/run/docker.sock
ReadWritePaths=-/mnt
ReadWritePaths=-/media
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
