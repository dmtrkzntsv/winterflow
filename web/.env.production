# Production (embedded-SPA) build defaults. `vite build` runs in production
# mode, so these override any local .env: the bundle embedded into the Go
# binary must be same-origin (empty base URLs -> window.location.origin, see
# src/config.ts) and standalone-flavored. Real shell env vars still win — to
# build a distributed-flavor or separately-hosted bundle, export the VITE_*
# vars before `pnpm build` (see .env.example).
VITE_API_BASE_URL=
VITE_APP_BASE_URL=
VITE_APP_MODE=standalone
