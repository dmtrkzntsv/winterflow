# WinterFlow hub (agents connect here over mTLS), installed by ship:
# `ship install winterflow/hub [--service S]`. A unit TEMPLATE: ship fills in
# its placeholders at install time. It works as the only unit of a service or
# next to the api and agent in one (ship then names it S-hub): its env example
# keeps its files in their own subdirectory of {{DATA_DIR}}. Redis is
# external: the After= below only orders against it when it runs on this host.
[Unit]
Description=WinterFlow hub (agents connect here over mTLS)
Documentation=https://github.com/dmtrkzntsv/winterflow
After=network-online.target redis-server.service redis-server@winterflow.service
Wants=network-online.target

[Service]
Type=simple
User={{USER}}
Group={{USER}}
EnvironmentFile={{ENV_FILE}}
# Relative paths in the env file (HUB_CERT_DIR, REDIS_CA_CERT_PATH) resolve
# against {{DATA_DIR}}, here and under `ship run winterflow/hub -- ...`.
WorkingDirectory={{DATA_DIR}}
ExecStart={{BIN}}
Restart=on-failure
RestartSec=5
# Stopping drains the hub first: it tells its agents to move to other hubs
# and waits up to 2 minutes for them to leave (not at all when no other hub
# can take them), then stops gracefully.
TimeoutStopSec=150
# HUB_PORT below 1024 needs AmbientCapabilities=CAP_NET_BIND_SERVICE and the
# same CapabilityBoundingSet= in a drop-in (`systemctl edit`).
CapabilityBoundingSet=

# Logging: one journald namespace per service (`ship logs` reads it), plus a
# rate limit.
LogNamespace={{SERVICE}}
LogRateLimitIntervalSec=30s
LogRateLimitBurst=10000

# Resource limits.
CPUWeight=90
TasksMax=512
LimitNOFILE=65536

# Hardening.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths={{DATA_DIR}}
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
