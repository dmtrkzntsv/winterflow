# WinterFlow API (distributed control plane + web UI), installed by ship
# (ship seeds /etc/<service>/api.env from this file once; edit it, then
# `ship start winterflow/api`). All options: .env.example in
# https://github.com/dmtrkzntsv/winterflow.
# Relative paths resolve against the service's data directory (/var/lib/<service>);
# the API keeps its own subdirectory so it can share a service with the hub
# and agent. PostgreSQL and Redis (TLS, password auth) are not installed by
# ship: scripts/install-control-plane.sh sets both up.

LOG_LEVEL=info
# Listen on loopback only; a reverse proxy serves WEB_URL.
API_LISTEN_ADDR=127.0.0.1
API_PORT=8080
WEB_URL=https://app.example.com
CORS_ALLOW_ORIGINS=https://app.example.com

# Required: generate with `openssl rand -hex 32` and keep it.
ENCRYPTION_KEY=

# The distributed API requires PostgreSQL.
DATABASE_URL=postgres://winterflow:change_me@127.0.0.1:5432/winterflow?sslmode=disable

# Redis admin user (only the API has it; hubs get their own users).
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_TLS=true
REDIS_CA_CERT_PATH=api/pki/ca.crt

# The CA pair (ca.crt, ca.key) the API signs hub and agent certificates with.
# Create it once with the hub binary (`winterflow-hub pki --dir <this dir>
# --host <hub host>`, what install-control-plane.sh runs), or copy an
# existing one here, owned by the service user.
HUB_CERT_DIR=api/pki
