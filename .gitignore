.env
.idea
.DS_Store
bin/


data/
*.sqlite*
# coverage reports (make test)
/coverage.out
# Postgres coverage profile (make test-pg TEST_PG_ARGS='... -coverprofile=contract-postgres.out')
/contract-postgres.out
# Redis integration coverage profile (scripts/test-redis.sh ... -coverprofile=redis.out)
/redis.out

# root-built binaries (go build ./cmd/...)
/agent
# /api is the committed OpenAPI document directory; only its generated
# contents are tracked (use `go build -o bin/api ./cmd/api` for the binary)
/api/*
!/api/openapi.yaml
/hub
/standalone

# goreleaser output
/dist/
