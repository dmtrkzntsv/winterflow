# Frontend build/dev-time vars (Vite). These matter for `pnpm dev` and for
# separately-hosted bundles only: `pnpm build` runs in production mode, where
# the committed .env.production pins same-origin empty base URLs + standalone
# mode for the bundle that gets embedded into the Go binary (go:embed of
# web/dist). Shell env vars override .env.production, e.g.:
#   VITE_APP_MODE=distributed pnpm --dir web run build

# Where the API lives. Empty/unset -> window.location.origin (same origin).
# Leave it empty for `pnpm dev`: the dev server proxies /api, /auth,
# /.well-known, /oauth/register, /oauth/token and /mcp to WINTERFLOW_DEV_API,
# so the UI is same-origin as in production (the session cookie and the
# X-Winterflow-Request header need no CORS). A UI hosted on another origin
# must be listed by name in the API's CORS_ALLOW_ORIGINS ("*" is not enough).
VITE_API_BASE_URL=""
# Public URL this SPA is served from. Empty/unset -> origin.
VITE_APP_BASE_URL=""
# "standalone" hides multi-server/org UI; anything else shows it.
VITE_APP_MODE="standalone"

# Dev server only (not baked into the bundle): the API `pnpm dev` proxies
# to. Default http://localhost:8080. For provider sign-in and MCP consent in
# dev, set the API's WEB_URL to the dev server's origin
# (http://localhost:5173).
#WINTERFLOW_DEV_API="http://localhost:8080"
