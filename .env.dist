# Google OAuth Configuration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/google/callback

# Server Configuration
BASE_URL=http://localhost:3000
API_PORT=8080
GRPC_PORT=50051
JWT_SECRET=your_jwt_secret_key
LOG_LEVEL=info

# Database Configuration
DATABASE_URL=sqlite3://winterflow.sqlite

# Certificates
CA_KEY_PATH=.certs/dev/ca.key
CA_CERT_PATH=.certs/dev/ca.crt
SERVER_KEY_PATH=.certs/dev/server.key
SERVER_CERT_PATH=.certs/dev/server_fullchain.crt

# API Token for protected endpoints
API_TOKEN=your_api_token_here

PPROF_PORT=6060
SENTRY_DSN=
SENTRY_SAMPLE_RATE=1.0

APPS_TEMPLATES_PATH=
APPS_TEMPLATES_ASSETS_PATH=

STRIPE_TOKEN=
STRIPE_WEBHOOK_SECRET=
STRIPE_AGENT_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=