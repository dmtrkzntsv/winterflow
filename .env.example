# WinterFlow environment template — the canonical, commented inventory of every
# variable the backend reads (via pkg/config or os.Getenv). Copy to .env and
# adjust; the standalone binary loads ./.env, then /etc/winterflow/winterflow.env
# (written by scripts/install.sh), then falls back to the process environment.
#
# Commented-out entries show the built-in default; uncommenting them unchanged
# is a no-op. The frontend has its own template: web/.env.example (VITE_* vars,
# read at build time).
#
# Keep this file in sync with the code: any env var added, renamed, or removed
# in Go must be reflected here in the same change.

# --- Core ---------------------------------------------------------------------

# Log verbosity: debug | info | warn | error. Empty means debug. The embedded
# Caddy ingress reuses this level, and "debug" additionally turns on ingress
# access logs.
LOG_LEVEL=info

# TCP port the HTTP API (and the web UI it embeds) listens on. Must differ
# from the ingress ports below: the embedded reverse proxy owns 80/443 for
# your deployed apps, winterflow itself answers here.
API_PORT=8080

# Public URL the web UI is served from. Also decides cookie security: an
# https:// value marks auth cookies Secure (plain-http deployments would
# silently drop them and every request would 401).
WEB_URL=http://localhost:8080

# Comma-separated CORS allowlist for browser requests. Default "*".
#CORS_ALLOW_ORIGINS=*

# HMAC secret signing session JWTs. REQUIRED; generate a long random value
# (e.g. `openssl rand -hex 32`). Rotating it invalidates all sessions.
# scripts/install.sh generates one automatically.
JWT_SECRET=change_me_openssl_rand_hex_32

# Region scopes the bus queue names (requests:<REGION> / responses:<REGION> /
# events:<REGION>). MUST match across API and Hub in the distributed topology.
# Recommended in standalone too, so queue names aren't bare "requests:".
REGION=local

# --- Database -----------------------------------------------------------------

# SQLite (standalone default) or Postgres. Migrations run on startup.
DATABASE_URL=sqlite://winterflow.sqlite
#DATABASE_URL=postgres://wfuser:wfpassword@localhost:5432/winterflow?sslmode=disable

# Set to "true" to log every SQL statement (bundebug). Very noisy; dev only.
#DEBUG_SQL=false

# --- Storage paths ------------------------------------------------------------

# Where uploaded org/user avatars are stored. Default: ./data/avatars.
AVATARS_STORAGE_PATH=data/avatars

# Agent data root: app git repositories live in {AGENT_DATA_DIR}/apps-data/{id}
# (each one IS the deployment), human-readable symlinks in .../apps, embedded
# Caddy state in .../caddy. Default "data" (relative to the working dir);
# always set an absolute path in production.
#AGENT_DATA_DIR=data

# --- Auth ---------------------------------------------------------------------

# Local email+password auth is always on. A fresh instance is claimed by the
# first registration (that account becomes the admin). Afterwards: standalone
# closes self-signup automatically; distributed self-signup (own org per
# registrant) follows this flag. Default true; set false to close it.
REGISTRATION_ENABLED=true

# Optional Google OAuth (distributed topology only) — set BOTH to enable.
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=

# --- Bus / Redis (distributed topology only) -----------------------------------
# Standalone uses an in-process bus and ignores all of these.

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=redis_password
#REDIS_DB=0

# Override the derived queue names if needed. Defaults: requests:<REGION>,
# responses:<REGION>, events:<REGION>.
#BUS_REQUEST_QUEUE=requests:local
#BUS_RESPONSE_QUEUE=responses:local
#BUS_EVENTS_QUEUE=events:local

# --- Hub / Agent (mTLS gRPC, distributed topology) ------------------------------

# Address the agent dials / the hub listens on.
HUB_HOST=localhost
HUB_PORT=50051

# X.509 subjects used when generating the hub CA and server certificates
# (make generate-hub-certs / generate-agent-certs).
HUB_CA_SUBJECT="/C=CA/O=WinterFlow.io/OU=CA/CN=WinterFlow.io CA/emailAddress=info@winterflow.io"
HUB_SERVER_SUBJECT="/C=CA/O=WinterFlow.io/OU=SERVER/CN=WinterFlow.io/emailAddress=info@winterflow.io"

# Where hub certificate material lives / the openssl extensions file path.
HUB_CERT_DIR=data/hub-certs
HUB_CERT_EXT_PATH=data/ext.cnf

# CA the agent verifies the hub against. Default: ca.crt inside HUB_CERT_DIR.
#AGENT_CA_CERT_PATH=data/hub-certs/ca.crt

# Agent identity override. Normally derived from the agent certificate's
# CommonName (set when the server is claimed); set explicitly only for
# operators/tests.
#AGENT_ID=

# --- Agent extras --------------------------------------------------------------

# Base URL for self-update downloads; layout:
# {base}/{vX.Y.Z}/winterflow-{standalone|agent}-{os}-{arch}
# (the asset naming .goreleaser.yaml publishes to GitHub releases).
#GITHUB_RELEASES_URL=https://github.com/dmtrkzntsv/winterflow/releases/download

# Docker credential store directory honored when listing registry image tags
# (standard Docker variable; default ~/.docker).
#DOCKER_CONFIG=

# --- Ingress (embedded Caddy; agent/standalone only) ----------------------------

# Master switch for the embedded reverse proxy. Default on. Set false to keep
# the process off 80/443 entirely — unprivileged dev runs, or a host where
# nginx/traefik/a tunnel already owns those ports. Disabled hides per-app
# domain editing in the UI (the agent reports ingress:false).
#INGRESS_ENABLED=true

# Listen ports for app traffic, separate from API_PORT above. 80/443 need root
# or CAP_NET_BIND_SERVICE (the systemd unit grants it); override for
# unprivileged dev runs — but never to API_PORT, which refuses to start the
# ingress rather than fight itself for the listener:
#INGRESS_HTTP_PORT=8081
#INGRESS_HTTPS_PORT=8443

# ACME (Let's Encrypt) account email for automatic HTTPS certificates.
#INGRESS_ACME_EMAIL=you@example.com

# Predefined throttling: per-client-IP request ceiling so traffic spikes get
# 429s instead of saturating the host. Defaults 50 rps / burst 100; 0 disables.
# Behind a tunnel/proxy all traffic shares one IP, making this a global cap —
# which still protects the machine.
#INGRESS_RATE_LIMIT_RPS=50
#INGRESS_RATE_LIMIT_BURST=100
