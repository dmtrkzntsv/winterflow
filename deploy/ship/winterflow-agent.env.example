# WinterFlow agent, installed by ship (ship seeds /etc/<service>/agent.env
# from this file once). All options: .env.example in
# https://github.com/dmtrkzntsv/winterflow.
# Relative paths resolve against the service's data directory (/var/lib/<service>);
# the agent keeps its own subdirectory so it can share a service with the
# api and hub.
#
# Enroll once with a token from the control plane, then start:
#   sudo ship run winterflow/agent -- enroll --url https://api.example.com \
#       --cert-dir agent/certs --data-dir agent --env-out agent/enroll.env
#   cat /var/lib/<service>/agent/enroll.env >> /etc/<service>/agent.env
#   sudo ship start winterflow/agent

LOG_LEVEL=info
AGENT_DATA_DIR=agent
HUB_CERT_DIR=agent/certs
