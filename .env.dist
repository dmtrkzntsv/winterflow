# WinterFlow v2 environment template.
# Copy to .env and fill in. Only the variables below are read by pkg/config.

# --- Core ---------------------------------------------------------------------
LOG_LEVEL=info
API_PORT=8080
WEB_URL=http://localhost:8080
API_URL=http://localhost:8080
CORS_ALLOW_ORIGINS=*
JWT_SECRET=your_jwt_secret_key

# Region scopes the bus queue names (requests:<REGION> / responses:<REGION>).
# It MUST match across the API and Hub in the distributed topology. Harmless but
# recommended in standalone too, so the queue names aren't bare "requests:".
REGION=local

# --- Database -----------------------------------------------------------------
DATABASE_URL=sqlite://winterflow.sqlite
#DATABASE_URL=postgres://wfuser:wfpassword@localhost:5432/winterflow?sslmode=disable

# --- Storage paths ------------------------------------------------------------
AVATARS_STORAGE_PATH=data/avatars
# Agent app data root (revisions + rendered deployments). Defaults to "data".
#AGENT_DATA_DIR=data

# --- Auth ---------------------------------------------------------------------
# Local email+password auth is always on. Accounts are created via the
# /register page: on a fresh instance the first registration claims it
# (becomes the admin; standalone's single organization). Afterwards
# standalone accounts are created by admins; distributed self-signup
# (own org per registrant) follows REGISTRATION_ENABLED.
REGISTRATION_ENABLED=true
# Google OAuth is optional (distributed topology only) — set both to enable:
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=

# --- Bus / Redis (distributed topology only; standalone uses an in-process bus) ---
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=redis_password
#REDIS_DB=0
# Override the derived queue names if needed (defaults: requests:<REGION> / responses:<REGION>).
#BUS_REQUEST_QUEUE=requests:local
#BUS_RESPONSE_QUEUE=responses:local

# --- Hub / Agent (mTLS) -------------------------------------------------------
HUB_HOST=localhost
HUB_PORT=50051
HUB_CA_SUBJECT="/C=CA/O=WinterFlow.io/OU=CA/CN=WinterFlow.io CA/emailAddress=info@winterflow.io"
HUB_SERVER_SUBJECT="/C=CA/O=WinterFlow.io/OU=SERVER/CN=WinterFlow.io/emailAddress=info@winterflow.io"
HUB_CERT_DIR=data/hub-certs
HUB_CERT_EXT_PATH=data/ext.cnf
# Agent verifies the hub against this CA; defaults to the hub CA in HUB_CERT_DIR.
#AGENT_CA_CERT_PATH=data/hub-certs/ca.crt

# --- Ingress (Caddy) -----------------------------------------------------------
# Embedded ingress (Caddy) — agent/standalone only.
# Ports 80/443 need root or CAP_NET_BIND_SERVICE; override for dev:
#INGRESS_HTTP_PORT=8080
#INGRESS_HTTPS_PORT=8443
#INGRESS_ACME_EMAIL=you@example.com
# Predefined throttling: per-client-IP request ceiling so traffic spikes get
# 429s instead of saturating the host. Defaults 50 rps / burst 100; 0 disables.
#INGRESS_RATE_LIMIT_RPS=50
#INGRESS_RATE_LIMIT_BURST=100
