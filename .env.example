# WinterFlow environment template — the canonical, commented inventory of every
# variable the backend reads (via pkg/config or os.Getenv). Copy to .env and
# adjust; the standalone binary loads ./.env, then /etc/winterflow/winterflow.env
# (written by scripts/install.sh), then falls back to the process environment.
#
# Commented-out entries show the built-in default; uncommenting them unchanged
# is a no-op. The frontend has its own template: web/.env.example (VITE_* vars,
# read at build time).
#
# Keep this file in sync with the code: any env var added, renamed, or removed
# in Go must be reflected here in the same change.

# --- Core ---------------------------------------------------------------------

# Log verbosity: debug | info | warn | error. Empty means debug. The embedded
# Caddy ingress reuses this level, and "debug" additionally turns on ingress
# access logs.
LOG_LEVEL=info

# TCP port the HTTP API (and the web UI it embeds) listens on. Must differ
# from the ingress ports below: the embedded reverse proxy owns 80/443 for
# your deployed apps, winterflow itself answers here.
API_PORT=8080

# Address the HTTP API binds to, joined with API_PORT. Empty (default) listens
# on every interface. Set 127.0.0.1 when a reverse proxy on the same host
# fronts the API (scripts/install-control-plane.sh does). Read by standalone
# and the distributed API.
#API_LISTEN_ADDR=

# Public URL the web UI is served from. Also decides cookie security: an
# https:// value marks the session cookie (wf_session) Secure (plain-http
# deployments would silently drop it and every request would 401). Alert
# notifications link to <WEB_URL>/server/<id>/monitoring (or the app's
# Metrics tab). Sign-in providers build their redirect URIs on it (they need
# an https origin, or http on localhost).
WEB_URL=http://localhost:8080

# Comma-separated CORS allowlist for browser requests. Default "*".
#CORS_ALLOW_ORIGINS=*

# Key the API derives the cipher of notification channel URLs from (Org ->
# Alerts -> Channels; sessions no longer use it: they are opaque tokens in
# the database). Generate a long random value (e.g. `openssl rand -hex 32`).
# After a rotation every channel fails with "cannot decrypt" until its URL is
# re-entered. Unset, channels cannot be saved or tested. Read by standalone
# and the distributed API. scripts/install.sh generates one automatically.
JWT_SECRET=change_me_openssl_rand_hex_32

# --- Database -----------------------------------------------------------------

# Standalone: SQLite (default when unset: sqlite://winterflow.sqlite) or
# Postgres. Distributed API: Postgres only (startup refuses sqlite://).
# Migrations run on startup.
# sqlite://<path> takes no query parameters: a path containing '?' or '#' is
# rejected at startup. Postgres takes libpq parameters such as sslmode and
# connect_timeout (seconds, default 5); behind PgBouncer use session pooling.
DATABASE_URL=sqlite://winterflow.sqlite
#DATABASE_URL=postgres://wfuser:wfpassword@localhost:5432/winterflow?sslmode=disable

# Set to "true" to log each SQL statement's text, duration and error through
# the app logger (never the arguments). Very noisy; dev only. Read by every
# topology that opens a database (standalone, api).
#DEBUG_SQL=false

# --- Storage paths ------------------------------------------------------------

# Agent data root: app git repositories live in {AGENT_DATA_DIR}/apps-data/{id}
# (each one IS the deployment), human-readable symlinks in .../apps, embedded
# Caddy state in .../caddy. Default "data" (relative to the working dir);
# always set an absolute path in production.
#AGENT_DATA_DIR=data

# --- Auth ---------------------------------------------------------------------

# Local email+password auth is always on; a sign-in sets the HttpOnly
# wf_session cookie (30 days from last use, 90 at most). A fresh instance is
# claimed by the first registration (that account becomes the admin).
# Afterwards: standalone closes self-signup automatically; distributed
# self-signup (own org per registrant) follows this flag. Default true; set false to close it.
REGISTRATION_ENABLED=true

# --- Sign-in providers (optional, either topology) -------------------------------
# Each provider is enabled when all of its variables are set AND WEB_URL is an
# https origin with no path (http only on localhost / 127.0.0.1 / [::1]). Register
# this redirect URI with the provider: <WEB_URL>/auth/oauth/<google|apple|oidc>/callback
# A provider sign-in for an address no account has creates an account only
# while registration is open (see REGISTRATION_ENABLED); an address an account
# already has is refused: its owner links the provider from their settings.

# Google — set BOTH.
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=

# Sign in with Apple — set ALL FOUR: the Services ID, the team id, the key id
# and the path of the .p8 private key (P-256) that signs the client secret.
#AUTH_APPLE_CLIENT_ID=
#AUTH_APPLE_TEAM_ID=
#AUTH_APPLE_KEY_ID=
#AUTH_APPLE_PRIVATE_KEY_PATH=/etc/winterflow/apple-auth.p8

# Any OpenID Connect provider (Keycloak, Authentik, Authelia, ...) — set the
# issuer URL (its /.well-known/openid-configuration is read), the client id and
# the client secret. AUTH_OIDC_NAME is the login button's label (default "SSO").
#AUTH_OIDC_ISSUER=https://id.example.com/realms/home
#AUTH_OIDC_CLIENT_ID=
#AUTH_OIDC_CLIENT_SECRET=
#AUTH_OIDC_NAME=SSO

# --- Bus / Redis (distributed topology only) -----------------------------------
# Standalone uses an in-process bus and ignores all of these.

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=redis_password
# Redis ACL user to connect as (API and hub; default empty = the `default`
# user). The API connects as the admin (`default` with requirepass) and
# manages one ACL user per hub, hub:<hub_id>, which may write only that hub's
# keys (and read every hub's status) and use only the channels a hub uses; a
# hub sets REDIS_USERNAME=hub:<hub_id> and the REDIS_PASSWORD the API handed
# it at enrollment. That Redis instance must hold only hub:* keys (a hub user
# may SCAN, which shows every key name).
#REDIS_USERNAME=
#REDIS_DB=0
# TLS to Redis (default true in distributed). Set REDIS_TLS=false only for
# local development against a plain Redis (e.g. the docker-compose one used by
# `make api` / `make hub`). REDIS_CA_CERT_PATH is the CA that signed Redis's
# certificate (default: the Winterflow CA, HUB_CERT_DIR/ca.crt).
REDIS_TLS=false
#REDIS_CA_CERT_PATH=

# Bus channel names are fixed (bus:requests[:<hub_id>], bus:responses,
# bus:events, hub:*); there is no REGION or queue-name override.

# --- Hub / Agent (mTLS gRPC, distributed topology) ------------------------------

# Address the agent dials / the hub listens on. On the agent,
# {AGENT_DATA_DIR}/hub.json (written when the API moves the server to another
# hub) overrides these two.
HUB_HOST=localhost
HUB_PORT=50051

# Agent: the API it asks which hub to connect to (POST /api/v1/agent/hub, signed
# with its certificate key) when its hub tells it to move, refuses it as
# belonging to another hub, or stays unreachable for 3 minutes. Written to the
# agent's env file by enrollment. Default: https://api.winterflow.dev.
#WINTERFLOW_API_URL=https://api.winterflow.dev

# Hub (cmd/hub) identity and placement. HUB_PUBLIC_ADDR is the host:port agents
# dial; the hub id (bus channel suffix) is its host part. Required by the hub.
#HUB_PUBLIC_ADDR=hub-01.winterflow.dev:50051
# Agents this hub should carry (default 1000; values < 1 mean the default).
#HUB_CAPACITY=1000
# Set false to stop assigning new agents to this hub (default true).
#HUB_ACCEPTING=true

# Where certificate material lives. The distributed API (cmd/api) reads the CA
# pair (ca.crt + ca.key) from HUB_CERT_DIR to sign agent certificates and
# refuses to start without a matching pair; the hub reads ca.crt, hub.crt and
# hub.key (make generate-hub-certs writes all of them for localhost). The agent
# reads agent.key + agent.crt here; standalone keeps only that pair (created
# once with CN = its server id, then kept: secrets are encrypted to the key).
HUB_CERT_DIR=data/hub-certs

# CA the agent verifies the hub against. Default: ca.crt inside HUB_CERT_DIR.
#AGENT_CA_CERT_PATH=data/hub-certs/ca.crt

# Agent identity override. Normally derived from the agent certificate's
# CommonName (set when the server is claimed); set explicitly only for
# operators/tests.
#AGENT_ID=

# --- Agent extras --------------------------------------------------------------

# Base URL for self-update downloads; layout:
# {base}/{vYYMMDD.N}/winterflow-{standalone|agent}-{os}-{arch}
# (the asset naming .goreleaser.yaml publishes to GitHub releases).
#GITHUB_RELEASES_URL=https://github.com/dmtrkzntsv/winterflow/releases/download

# Docker credential store directory honored when listing registry image tags
# (standard Docker variable; default ~/.docker).
#DOCKER_CONFIG=

# Ceiling on the age of backup copies, in days (standalone/agent): no copy of
# any kind, of any app (deleted apps' backups included), is kept longer,
# whatever the backup's own retention says. A scheduled backup whose data
# hasn't changed uploads a fresh copy once its newest one is older than half
# of this, so it always keeps one. 0 = no ceiling; the maximum is 36500
# (larger values are capped). Default 180.
#BACKUP_RETENTION_DAYS=180

# Host ports the agent allocates for x-winterflow expose entries
# (standalone/agent), "low-high". An http entry is published on 127.0.0.1 (the
# ingress proxies to it), a tcp/udp entry on every interface. Allocations are
# stored in each app's .winterflow/config.json and kept across redeploys and
# rollbacks; a port the user pins may be outside the range. Default
# 20000-29999.
#EXPOSE_PORT_RANGE=20000-29999

# --- Monitoring -----------------------------------------------------------------

# Resource metrics. Agent and standalone: sample host and container CPU,
# memory, disk, network and temperature every 60 s from procfs/cgroupfs (file
# reads, no process forks) and send them as server.metrics events. API and
# standalone: store them, roll them up (10 min -> 8 h buckets) and serve the
# charts. false (or 0) turns collection off on an agent and storage off on an
# API. Default true.
#METRICS_ENABLED=true

# Agent/standalone: how often per-app disk usage is measured, with one
# `docker system df -v` (bounded by a 5-minute timeout; ~45 s on a busy box)
# plus a walk of each app directory. Go duration; default 1h, 0 disables,
# values under 5m are raised to 5m.
#METRICS_DISK_INTERVAL=1h

# --- Alerts (API/standalone) --------------------------------------------------

# Whether alert notifications may be sent to loopback, private (RFC 1918,
# ULA), link-local (incl. cloud metadata) and CGNAT addresses: a LAN ntfy,
# Gotify, webhook or mail server. Default: true in standalone, false on the
# distributed API (self-registered orgs must not reach its network). Every
# connection is checked when it is made (HTTP, smtp, mqtt, xmpp, the Matrix
# login), redirects included; validating a channel URL never connects.
#ALERTS_ALLOW_PRIVATE_TARGETS=

# --- Catalog (API/standalone) --------------------------------------------------

# The template catalog: a signed feed (catalog.json and catalog.json.sig) the
# API fetches a minute after start and then every CATALOG_REFRESH (a failed sync
# is retried after 5 minutes, doubling up to CATALOG_REFRESH), with
# If-None-Match (one conditional GET a day), a 30 s deadline per request and an
# 8 MiB cap; https only (http only to a loopback host). Each app in it is a
# read-only catalog template every organization can install. Set it empty
# (CATALOG_URL=) to switch the catalog off: catalog templates are hidden from
# lists and new installs (instances keep working) until it is set again.
#CATALOG_URL=https://winterflow.io/catalog/catalog.json

# The ed25519 public key (standard base64) the feed's signature must verify
# against; a feed that does not verify is refused as a whole. Default: the key
# of winterflow.io's published feed. Set it only to sync a feed you build and
# sign yourself (`go run ./cmd/catalog keygen`, then `catalog build
# --sign-key-env CATALOG_SIGNING_KEY`).
#CATALOG_PUBLIC_KEY=QAyhWPQDK0IS8UvVtNA3X/vXwSisba2Lx/7bxI3CG0E=

# How often the catalog feed is synced: a Go duration, default 24h; values
# under 5m are raised to 5m.
#CATALOG_REFRESH=24h

# --- Ingress (embedded Caddy; agent/standalone only) ----------------------------

# Master switch for the embedded reverse proxy. Default OFF (opt-in) — many
# hosts already have nginx/traefik/a tunnel owning 80/443. Set true to serve
# per-app domains from this process. Disabled hides per-app domain editing in
# the UI (the agent reports ingress:false).
#INGRESS_ENABLED=false

# Listen ports for app traffic, separate from API_PORT above. 80/443 need root
# or CAP_NET_BIND_SERVICE (the systemd unit grants it); override for
# unprivileged dev runs — but never to API_PORT, which refuses to start the
# ingress rather than fight itself for the listener:
#INGRESS_HTTP_PORT=8081
#INGRESS_HTTPS_PORT=8443

# ACME (Let's Encrypt) account email for automatic HTTPS certificates.
#INGRESS_ACME_EMAIL=you@example.com

# Predefined throttling: per-client-IP request ceiling so traffic spikes get
# 429s instead of saturating the host. Defaults 50 rps / burst 100; 0 disables.
#INGRESS_RATE_LIMIT_RPS=50
#INGRESS_RATE_LIMIT_BURST=100

# Proxies in front of the ingress whose client-IP headers the ingress trusts
# (agent/standalone; Caddy's trusted_proxies on both servers). Comma-separated
# CIDRs or IPs; default empty = the client is always the TCP peer. Behind a
# tunnel/CDN every request otherwise shares the proxy's IP and so one
# throttle bucket. For a request from a listed peer the client IP is read
# from CF-Connecting-IP, then X-Forwarded-For, right to left, skipping listed
# hops and non-IP values (else the peer); headers from unlisted peers are
# always ignored. List only proxies that overwrite CF-Connecting-IP
# (cloudflared, Cloudflare's edge): any listed peer can name any client.
# Caddy also passes a listed peer's X-Forwarded-For/-Proto/-Host on to apps
# as-is, so any container inside a listed docker range can spoof them — list
# only ranges whose every address is a proxy you control. A CF-Connecting-IP
# that itself falls inside a listed range is skipped like a proxy hop (the
# client is then the next X-Forwarded-For hop, else the peer).
# Invalid entries are ignored with a warning.
# Cloudflare Tunnel (cloudflared as a docker app): the docker bridge range,
#   172.16.0.0/12. Cloudflare proxy: https://www.cloudflare.com/ips/ (see
#   docs/recipes/cloudflare-tunnel.md).
#INGRESS_TRUSTED_PROXIES=
