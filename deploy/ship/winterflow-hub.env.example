# WinterFlow hub, installed by ship (ship seeds /etc/<service>/hub.env from
# this file once). All options: .env.example in
# https://github.com/dmtrkzntsv/winterflow.
# Relative paths resolve against the service's data directory (/var/lib/<service>);
# the hub keeps its own subdirectory so it can share a service with the api
# and agent.
#
# Join the control plane once with a one-time token (`winterflow-api
# hub-token` on the control plane; read from stdin), copy the Redis user the
# join writes into this file, then start:
#   echo wfh_... | sudo ship run winterflow/hub -- join \
#       --api-url https://api.example.com --public-addr hub.example.com:50051 \
#       --cert-dir hub/certs --redis-env-out hub/redis.env
#   cat /var/lib/<service>/hub/redis.env   # REDIS_USERNAME, REDIS_PASSWORD
#   sudo ship start winterflow/hub

LOG_LEVEL=info
# host:port agents dial; it is in the hub's certificate.
HUB_PUBLIC_ADDR=hub.example.com:50051
HUB_PORT=50051
HUB_CAPACITY=500
HUB_CERT_DIR=hub/certs

# The hub's own Redis user (hub:<hub id>) from the join, never the admin one.
REDIS_ADDR=redis.example.com:6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS=true
REDIS_CA_CERT_PATH=hub/certs/ca.crt
